# ReelCraft Studio Backend Environment Variables
# Copy this file to backend/.env before starting FastAPI or PostgreSQL.
# NEVER commit real passwords or keys to Git.

# PostgreSQL (created from scratch via Docker Compose or local PostgreSQL)
POSTGRES_USER="reelcraft"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
POSTGRES_DB="reelcraft_studio"
DATABASE_URL="postgresql+asyncpg://reelcraft:CHANGE_ME_STRONG_PASSWORD@localhost:5432/reelcraft_studio"

# FastAPI Security & CORS
APP_ENV="development"
CORS_ORIGINS="http://localhost:3000"
RATE_LIMIT_GENERATIONS_PER_MIN=5

# Storage Mode: "local" for safe local disk storage or "s3" for S3-compatible buckets
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="../storage"

# S3-Compatible Object Storage (used when STORAGE_BACKEND="s3")
S3_ENDPOINT_URL="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="reelcraft-studio-assets"
S3_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"

# Self-Hosted Cloud GPU Worker (RunPod / Vast.ai / Modal)
GPU_WORKER_BASE_URL=""
GPU_WORKER_AUTH_TOKEN=""
GPU_REQUEST_TIMEOUT_SECONDS=600
GPU_IDLE_SHUTDOWN_MINUTES=15
DEFAULT_VIDEO_MODEL="wan-2.2-ti2v-5b"
