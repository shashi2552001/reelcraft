# GEMINI_API_KEY: Optional if adding server-side Gemini tools later.
# AI Studio automatically injects runtime secrets when configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted applet URL injected by AI Studio runtime.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: FastAPI backend base URL (e.g., http://localhost:8000).
# Leave empty until your local or cloud FastAPI backend is running.
VITE_API_BASE_URL=""
